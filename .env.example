# Copy to .env (never commit .env). Same values as Thread's .env work here.
LLM_MODE=offline            # "live" = real models + OpenAI embeddings (costs money)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Shopify (read-only). Scopes: read_products, read_orders, read_inventory, read_content, read_legal_policies
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional: Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
